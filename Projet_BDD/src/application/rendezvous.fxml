<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane prefHeight="550.0" prefWidth="700.0"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="application.RendezVousController">
    <stylesheets>
        <URL value="@application.css"/>
    </stylesheets>
    <children>
        <VBox spacing="15" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
              AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
            <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>

            <!-- Top bar -->
            <HBox alignment="CENTER_LEFT">
                <Button onAction="#goBack" styleClass="icon-button">
    <graphic>
        <ImageView fitWidth="20" fitHeight="20" preserveRatio="true">
            <image>
                <Image url="@back.png"/>
            </image>
        </ImageView>
    </graphic>
</Button>
            </HBox>

            <!-- Filter bar -->
            <HBox alignment="CENTER" spacing="10">
                <ComboBox fx:id="filterMedecin" promptText="Filtrer par médecin"
                          prefWidth="200" onAction="#applyFilter"/>
                <DatePicker fx:id="filterDate" promptText="Filtrer par date"
                            prefWidth="180" onAction="#applyFilter"/>
                <Button onAction="#resetFilter" styleClass="icon-button"> 
                <graphic>
        <ImageView fitWidth="23" fitHeight="23" preserveRatio="true">
            <image>
                <Image url="@refresh.png"/>
            </image>
        </ImageView>
    </graphic>
</Button>
                <Button onAction="#openAddDialog" styleClass="list-toggle-button">
                <graphic>
        <ImageView fitWidth="23" fitHeight="23" preserveRatio="true">
            <image>
                <Image url="@Pluscircle.png"/>
            </image>
        </ImageView>
    </graphic>
</Button>
            </HBox>

            <!-- Toggle list -->
            <HBox alignment="CENTER">
                <Button fx:id="toggleButton" text="Liste des rendez-vous "
                        onAction="#toggleList" styleClass="list-toggle-button"/>
            </HBox>

            <!-- Appointment list -->
            <ScrollPane fx:id="listScrollPane" fitToWidth="true"
                        VBox.vgrow="ALWAYS">
                <content>
                    <VBox fx:id="rdvListBox" spacing="10">
                        <padding><Insets top="10" right="5" bottom="10" left="5"/></padding>
                    </VBox>
                </content>
            </ScrollPane>

        </VBox>
    </children>
</AnchorPane>