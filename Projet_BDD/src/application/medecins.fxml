<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane prefHeight="500.0" prefWidth="650.0"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="application.MedecinsController">
    <stylesheets>
        <URL value="@application.css"/>
    </stylesheets>
    <children>
        <VBox spacing="15" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
              AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
            <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>

            <!-- Top bar -->
            <HBox alignment="CENTER_LEFT">
               <Button onAction="#goBack" styleClass="icon-button">
    <graphic>
        <ImageView fitWidth="20" fitHeight="20" preserveRatio="true">
            <image>
                <Image url="@back.png"/>
            </image>
        </ImageView>
    </graphic>
</Button>
            </HBox>

            <!-- Search bar -->
            <HBox alignment="CENTER" spacing="10">
                <TextField fx:id="searchField"
                           promptText="Rechercher par nom ou spécialité..."
                           prefWidth="400" styleClass="search-field"
                           onKeyReleased="#handleSearch"/>
                <Button onAction="#openAddDialog" styleClass="add-button">
                <graphic>
        <ImageView fitWidth="23" fitHeight="23" preserveRatio="true">
            <image>
                <Image url="@Pluscircle.png"/>
            </image>
        </ImageView>
    </graphic>
</Button>
            </HBox>

            <!-- Liste des médecins button -->
            <HBox alignment="CENTER">
                <Button fx:id="toggleButton" text="Liste des médecins "
                        onAction="#toggleList" styleClass="list-toggle-button"/>
            </HBox>

            <!-- Medecin list -->
            <ScrollPane fx:id="listScrollPane" fitToWidth="true"
                        VBox.vgrow="ALWAYS" styleClass="scroll-pane">
                <content>
                    <VBox fx:id="medecinListBox" spacing="10">
                        <padding><Insets top="10" right="5" bottom="10" left="5"/></padding>
                    </VBox>
                </content>
            </ScrollPane>

        </VBox>
    </children>
</AnchorPane>