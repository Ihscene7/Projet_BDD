<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.image.Image?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="500.0" prefWidth="650.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.PatientsController">
    <stylesheets>
        <URL value="@application.css" />
    </stylesheets>
    <children>
        <VBox spacing="15" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
            <padding><Insets bottom="15" left="20" right="20" top="15" /></padding>

            <!-- Top bar -->
            <HBox alignment="CENTER_LEFT">
                <Button onAction="#goBack" styleClass="icon-button">
    <graphic>
        <ImageView fitWidth="20" fitHeight="20" preserveRatio="true">
            <image>
                <Image url="@back.png"/>
            </image>
        </ImageView>
    </graphic>
</Button>
            </HBox>

            <!-- Search bar -->
            <HBox alignment="CENTER" spacing="10">
                <TextField fx:id="searchField" onKeyReleased="#handleSearch" prefWidth="400" promptText="Rechercher par nom ou numéro de téléphone..." styleClass="search-field" />
               <Button onAction="#openAddDialog" styleClass="add-button">
                <graphic>
        <ImageView fitWidth="23" fitHeight="23" preserveRatio="true">
            <image>
                <Image url="@Pluscircle.png"/>
            </image>
        </ImageView>
    </graphic>
</Button>
            </HBox>

            <!-- Liste des patients button -->
            <HBox alignment="CENTER">
                <Button fx:id="toggleButton" onAction="#toggleList" styleClass="list-toggle-button" text="Liste des patients" />
            </HBox>

            <!-- Patient list -->
            <ScrollPane fx:id="listScrollPane" fitToWidth="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS">
                <content>
                    <VBox fx:id="patientListBox" spacing="10">
                        <padding><Insets bottom="10" left="5" right="5" top="10" /></padding>
                    </VBox>
                </content>
            </ScrollPane>

        </VBox>
    </children>
</AnchorPane>
